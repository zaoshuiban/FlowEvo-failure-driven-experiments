{
  "version": "public_view_v1",
  "task_allowlist": [
    "problem_id",
    "prompt",
    "starter_code",
    "function_name",
    "public_examples"
  ],
  "feedback_allowlist": [
    "status",
    "summary_from_canonical_map",
    "public_cases"
  ],
  "excluded": [
    "input_output",
    "hidden_tests",
    "reference_solution",
    "final_score",
    "future_trace",
    "private_failed_case",
    "arbitrary_feedback_text"
  ],
  "public_case_requirement": [
    "visibility=public",
    "legal_verified=true"
  ],
  "note": "Visibility/legal flags are supplied by the trusted host controller, never by candidate code."
}