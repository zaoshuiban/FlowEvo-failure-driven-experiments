  "code": "import sys\n\ndef solve():\n    data = list(map(int, sys.stdin.read().split()))\n    if len(data) < 24:\n        return\n    cube = data[:24]\n\n    def solved(c):\n        for i in range(0, 24, 4):\n            if not (c[i] == c[i+1] == c[i+2] == c[i+3]):\n                return False\n        return True\n\n    # Faces: 0-3 U, 4-7 F, 8-11 R, 12-15 B, 16-19 L, 20-23 D\n    # Each move is a list of cycles. A cycle (a,b,c,d) means a<-b, b<-c, c<-d, d<-a.\n    moves = [\n        # U clockwise\n        [(0,1,3,2), (4,16,12,8), (5,17,13,9)],\n        # U counterclockwise\n        [(0,2,3,1), (4,8,12,16), (5,9,13,17)],\n        # F clockwise\n        [(4,5,7,6), (3,8,20,19), (1,10,22,17)],\n        # F counterclockwise\n        [(4,6,7,5), (3,17,22,10), (1,19,20,8)],\n        # R clockwise\n        [(8,9,11,10), (1,4,20,13), (3,6,22,15)],\n        # R counterclockwise\n        [(8,10,11,9), (1,13,20,4), (3,15,22,6)],\n        # B clockwise\n        [(12,13,15,14), (2,9,21,18), (3,11,20,16)],\n        # B counterclockwise\n        [(12,14,15,13), (2,16,21,11), (3,18,20,9)],\n        # L clockwise\n        [(16,17,19,18), (0,12,20,4), (2,14,22,6)],\n        # L counterclockwise\n        [(16,18,19,17), (0,4,20,12), (2,6,22,14)],\n        # D clockwise\n        [(20,21,23,22), (7,11,15,19), (6,10,14,18)],\n        # D counterclockwise\n        [(20,22,23,21), (7,19,15,11), (6,18,14,10)],\n    ]\n\n    for move in moves:\n        c = cube[:]\n        for cycle in move:\n            temp = c[cycle[-1]]\n            for i in range(len(cycle) - 1, 0, -1):\n                c[cycle[i]] = c[cycle[i - 1]]\n            c[cycle[0]] = temp\n        if solved(c):\n            print(\"YES\")\n            return\n\n    print(\"NO\")\n\nif __name__ == \"__main__\":\n    solve()",
