  "code": "import sys\n\ndef main():\n    data = list(map(int, sys.stdin.buffer.read().split()))\n    if not data:\n        return\n\n    n = data[0]\n    arr = data[1:1 + n]\n\n    if not arr:\n        print(0)\n        return\n\n    max_val = max(arr)\n    freq = [0] * (max_val + 2)\n    for x in arr:\n        freq[x] += 1\n\n    dp = [0] * (max_val + 2)\n    dp[1] = freq[1]\n\n    for i in range(2, max_val + 1):\n        dp[i] = max(dp[i - 1], dp[i - 2] + freq[i] * i)\n\n    print(dp[max_val])\n\nif __name__ == \"__main__\":\n    main()",
