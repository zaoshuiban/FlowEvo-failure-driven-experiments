  "code": "def solve():\n    import sys\n    n, t = map(int, sys.stdin.read().split())\n    # check if t is power of 2\n    if t & (t - 1) != 0:\n        print(0)\n        return\n    k = t.bit_length() - 1\n    bin_n = bin(n)[2:]\n    L = len(bin_n)\n    # dp[pos][tight][started][zeros]\n    # we can use memoization or iterative\n    from functools import lru_cache\n    @lru_cache(None)\n    def dp(pos, tight, started, zeros):\n        if zeros > k:\n            return 0\n        if pos == L:\n            return 1 if started and zeros == k else 0\n        limit = int(bin_n[pos]) if tight else 1\n        total = 0\n        for d in range(limit + 1):\n            ntight = tight and (d == limit)\n            if not started:\n                if d == 0:\n                    total += dp(pos+1, ntight, False, zeros)\n                else:\n                    total += dp(pos+1, ntight, True, zeros)\n            else:\n                if d == 0:\n                    total += dp(pos+1, ntight, True, zeros+1)\n                else:\n                    total += dp(pos+1, ntight, True, zeros)\n        return total\n    ans = dp(0, True, False, 0)\n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()",
